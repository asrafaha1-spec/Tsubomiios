<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundleDisplayName</key>
	<string>Hinoki</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>16.3</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>

	<!-- Expose Documents in the Files app, so firmware and games can be dropped into Documents/Import -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- The library rotates freely; the game window is landscape only (SDL_HINT_ORIENTATIONS) -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>LSApplicationCategoryType</key>
	<string>public.app-category.games</string>
	<key>LSSupportsGameMode</key>
	<true/>
	<key>GCSupportsGameMode</key>
	<true/>
	<!-- No 120 Hz on ProMotion iPhones: a PS Vita never draws more than 60 frames a second, and letting the
	     display and the app's own animations run at 120 Hz only added heat -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<false/>
	<!-- Game controllers can drive the app, not only the touch screen -->
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>SDLSceneConfiguration</string>
					<key>UISceneDelegateClassName</key>
					<string>SDLUIKitSceneDelegate</string>
				</dict>
			</array>
			<key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>V3KExternalDisplay</string>
					<key>UISceneDelegateClassName</key>
					<string>V3KExternalDisplaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<key>NSCameraUsageDescription</key>
	<string>Some PS Vita games use the camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Some PS Vita games use the microphone.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Used to enable JIT on this iPhone (through LocalDevVPN) and for PS Vita ad-hoc multiplayer.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_remotepairing._tcp</string>
	</array>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Screenshots you take in a game are saved to Photos.</string>
	<key>NSMotionUsageDescription</key>
	<string>Some PS Vita games are controlled by tilting.</string>

	<!-- "Open in Vita3K" for games, packages and firmware (Alternate: Vita3K never takes over zips) -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PS Vita content</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.vita3k.vpk</string>
				<string>org.vita3k.pkg</string>
				<string>org.vita3k.pup</string>
				<string>public.zip-archive</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.vita3k.vpk</string>
			<key>UTTypeDescription</key>
			<string>PS Vita homebrew package</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>vpk</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.vita3k.pkg</string>
			<key>UTTypeDescription</key>
			<string>PS Vita package</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pkg</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.vita3k.pup</string>
			<key>UTTypeDescription</key>
			<string>PS Vita firmware</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pup</string>
					<string>PUP</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- vita3k://launch/<TITLE ID> starts a game, e.g. from a Home Screen shortcut -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>stikjit</string>
		<string>stosdebug</string>
		<string>apple-magnifier</string>
		<string>livecontainer</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.vita3k.ios.launch</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vita3k</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
